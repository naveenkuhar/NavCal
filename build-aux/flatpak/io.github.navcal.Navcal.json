{
  "id": "io.github.navcal.Navcal",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "navcal",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--talk-name=org.gnome.evolution.dataserver.Sources5",
    "--talk-name=org.gnome.evolution.dataserver.Calendar8",
    "--talk-name=org.gnome.evolution.dataserver.AddressBook10",
    "--talk-name=org.gnome.evolution.dataserver.UserPrompter0",
    "--talk-name=org.gnome.Evolution-alarm-notify",
    "--talk-name=org.gnome.Settings"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/lib/cmake",
    "/share/pkgconfig",
    "/share/gir-1.0",
    "/share/gtk-doc",
    "/share/doc",
    "/share/man",
    "*.a",
    "*.la"
  ],
  "modules": [
    {
      "name": "libical",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_INSTALL_LIBDIR=lib",
        "-DBUILD_SHARED_LIBS=ON",
        "-DICAL_BUILD_DOCS=OFF",
        "-DICAL_GLIB=ON",
        "-DGOBJECT_INTROSPECTION=ON",
        "-DICAL_GLIB_VAPI=OFF",
        "-DLIBICAL_BUILD_TESTING=OFF",
        "-DWITH_CXX_BINDINGS=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/libical/libical/releases/download/v3.0.20/libical-3.0.20.tar.gz",
          "sha256": "e73de92f5a6ce84c1b00306446b290a2b08cdf0a80988eca0a2c9d5c3510b4c2"
        }
      ]
    },
    {
      "name": "evolution-data-server",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DENABLE_GTK=OFF",
        "-DENABLE_GTK4=OFF",
        "-DENABLE_CANBERRA=OFF",
        "-DENABLE_EXAMPLES=OFF",
        "-DENABLE_GOA=OFF",
        "-DENABLE_GTK_DOC=OFF",
        "-DENABLE_INSTALLED_TESTS=OFF",
        "-DENABLE_INTROSPECTION=ON",
        "-DENABLE_VALA_BINDINGS=OFF",
        "-DENABLE_WEATHER=OFF",
        "-DENABLE_OAUTH2_WEBKITGTK=OFF",
        "-DENABLE_OAUTH2_WEBKITGTK4=OFF",
        "-DWITH_OPENLDAP=OFF",
        "-DWITH_LIBDB=OFF",
        "-DWITH_PHONENUMBER=OFF",
        "-DWITH_KRB5=OFF",
        "-DWITH_SYSTEMDUSERUNITDIR=OFF"
      ],
      "cleanup": [
        "/bin",
        "/libexec",
        "/lib/evolution-data-server/addressbook-backends",
        "/lib/evolution-data-server/calendar-backends",
        "/lib/evolution-data-server/camel-providers",
        "/lib/evolution-data-server/credential-modules",
        "/lib/evolution-data-server/registry-modules",
        "/share/applications",
        "/share/dbus-1",
        "/share/evolution-data-server",
        "/share/pixmaps",
        "/etc"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/evolution-data-server/3.62/evolution-data-server-3.62.0.tar.xz",
          "sha256": "78be88e9a511f5afe7ff2e363eade84b622dd0282647fc576edb2d4ff2962cba"
        }
      ]
    },
    {
      "name": "navcal",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [".git", ".venv", ".flatpak", ".flatpak-builder", "build", "docs", "tests",
                   ".pytest_cache", ".ruff_cache"]
        }
      ]
    }
  ]
}
