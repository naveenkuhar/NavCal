"""Starts Navcal as installed (the package is in @PKGDATADIR@)."""

import os
import sys

sys.path.insert(1, "@PKGDATADIR@")
os.environ.setdefault("NAVCAL_LOCALEDIR", "@LOCALEDIR@")

from navcal import main  # noqa: E402

sys.exit(main())
